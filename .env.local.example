# Copy to `.env.local` after running `npx convex dev`

# Required for live Control Tower data. Use the public URL printed by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Optional: live LLM agent path for `npm run agent:run` (never commit real keys)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: host OS demo (see docs/HOST_DEMO.md)
# OPENAGENTOS_EXECUTOR_ROOT=
# HOST_EXECUTOR_SECRET=
# Set the same HOST_EXECUTOR_SECRET in the Convex dashboard environment variables.
# OPENAGENTOS_ADAPTER_TEST_APPROVE=1   # only for scripted approve/reject via npm run adapter
# AUTO_APPROVE_HOST_DEMO=1             # only for npm run demo:host end-to-end without Control Tower
